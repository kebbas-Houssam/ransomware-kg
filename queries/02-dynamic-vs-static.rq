# Detection papers grouped by analysis type (static vs dynamic), with their approaches.
PREFIX rkg:  <https://w3id.org/rkg#>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?analysisType (COUNT(DISTINCT ?p) AS ?papers)
       (GROUP_CONCAT(DISTINCT ?approach; separator=" | ") AS ?approaches)
WHERE {
  ?p rkg:hasApproach ?a .
  ?a rdfs:label ?approach ; rkg:analysisType/rdfs:label ?analysisType .
}
GROUP BY ?analysisType
ORDER BY DESC(?papers)
